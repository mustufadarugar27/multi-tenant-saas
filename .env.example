APP_NAME=MultiTenantSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker service name is "mysql" — change to 127.0.0.1 if running without Docker
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

# Docker service name is "redis" — change to 127.0.0.1 if running without Docker
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_BASE_DOMAIN=localhost

# ── Stripe
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

STRIPE_STARTER_MONTHLY_PRICE_ID=price_
STRIPE_STARTER_YEARLY_PRICE_ID=price_
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_

# ── Billing
BILLING_TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=3
BILLING_RETRY_ATTEMPTS=3
BILLING_PORTAL_RETURN_URL="${APP_URL}/billing"

# ── Laravel Reverb (WebSockets)
BROADCAST_CONNECTION=reverb
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_APP_ID=1
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser connects to localhost directly (Vite inlines these at build time)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
